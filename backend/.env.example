# Copy this file to backend/.env and fill in your deployment values.
#
# For Render deployment:
#   - POSTGRES_URL is automatically set from the database connection string
#   - REDIS_URL, CELERY_BROKER_URL, CELERY_RESULT_BACKEND are set from Redis service
#   - JWT_SECRET and PRIVACY_SALT are auto-generated
#   - Set FRONTEND_URL to your Vercel app URL
#   - Set GROQ_API_KEY and/or OPENAI_API_KEY for LLM features

APP_ENV=production
PORT=3001
FRONTEND_URL=https://your-vercel-app.vercel.app

# Database — Render auto-populates POSTGRES_URL from the database addon
POSTGRES_URL=postgresql+asyncpg://username:password@host:port/database

# Security — Render auto-generates these, but you can set custom values
JWT_SECRET=your_jwt_secret_key
PRIVACY_SALT=your_privacy_salt

# Redis & Celery — Render auto-populates these from the Redis addon
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM Provider — set at least one
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=llama3-8b-8192
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ML / RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5

# Sentry error monitoring (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
