# LifeLink Frontend Environment
# 
# Local development (npm run dev): uses this file → connects to backend at the URL below
# Docker production: this file is excluded via .dockerignore
#   → VITE_API_URL is undefined → API_BASE_URL is empty string
#   → frontend uses relative URLs (e.g. /v2/auth/login)
#   → nginx reverse proxy forwards to backend:3001
#
# DO NOT change the port in this file — it's only for local dev.
VITE_API_URL=http://localhost:3001
