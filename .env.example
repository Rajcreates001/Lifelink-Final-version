[TEMPLATE]
# ============================================================
# LifeLink — Environment Variables
# Copy this to .env and fill in your API keys
# ============================================================

# ─── Required: LLM Provider (OpenAI-compatible endpoint) ──
# Primary: OpenAI-compatible API (from EVA/design.md config)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=http://your-llm-endpoint:8000/v1
LLM_ENDPOINT=http://your-llm-endpoint:8000/v1/chat/completions
LLM_MODEL_NAME=qwen3.6-27b
LLM_MAX_OUTPUT_TOKENS=8192
LLM_PROVIDER=openai

# Fallback: Groq (if OpenAI endpoint is unreachable)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Security ──────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_string
JWT_SECRET=change_this_to_a_secure_random_string
PRIVACY_SALT=change_this_to_a_secure_random_string

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifelink_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifelink_db

# ─── Redis & Celery ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Optional: Email Notifications ──────────────────────
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=noreply@lifelink.ai

# ─── Optional: Demo seed password ──────────────────────
# DEMO_PASSWORD=ChangeThisInProduction

# ============================================================
# AI INFRASTRUCTURE — Headroom + SIE + Edge AI
# ============================================================

# ─── Headroom (Context Compression) ─────────────────────────
# Compresses tool outputs, RAG chunks, and conversation history
# before they reach the LLM. 60-95% fewer tokens for JSON data.
HEADROOM_ENABLED=false
# HEADROOM_MODEL=kompress-v2-base
# HEADROOM_COMPRESSION_LEVEL=balanced
# HEADROOM_CCR_ENABLED=true
# HEADROOM_CCR_TTL_SECONDS=3600

# ─── SIE (Superlinked Inference Engine) ─────────────────────
# Self-hosted inference for embeddings, reranking, extraction.
SIE_ENABLED=false
# SIE_BASE_URL=http://localhost:8080
# SIE_API_KEY=
# SIE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SIE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# SIE_TIMEOUT_SECONDS=30

# ─── Edge AI (Ambulance Runtime) ────────────────────────────
EDGE_AI_ENABLED=false
# EDGE_AI_FALLBACK_MODE=rule_based

# ─── Feature Flags ──────────────────────────────────────────
ENABLE_SEMANTIC_SEARCH=true
ENABLE_RERANKING=true
ENABLE_AI_STRUCTURED_OUTPUT=true
ENABLE_OFFLINE_AMBULANCE_MODE=false
ENABLE_AI_OBSERVABILITY=true
ENABLE_SCRAPLING_SEARCH=true
