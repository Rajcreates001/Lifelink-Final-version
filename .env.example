# ============================================================
# LifeLink — Environment Variables
# Copy this to backend/.env (or your deployment environment) and fill in values.
# NEVER commit real credentials.
# ============================================================

# --- LLM Provider: choose ONE of the two options below --------
# LLM_PROVIDER: "groq" (default) or "openai" (any OpenAI-compatible endpoint)
LLM_PROVIDER=groq

# Option A: Groq (default provider)
GROQ_API_KEY=
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16k-instruct

# Option B: OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, ...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# LLM_MAX_OUTPUT_TOKENS=8192

# --- Security (REQUIRED - generate with: openssl rand -hex 32) ---
JWT_SECRET=
PRIVACY_SALT=
# ENCRYPTION_KEY=            # optional: Fernet key for data-at-rest encryption

# --- Database ------------------------------------------------
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifelink_db

# --- Redis & Celery ------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- App ------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:5000
HOST=0.0.0.0
PORT=3001

# --- Optional: Sentry error monitoring ------------------------
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Optional: Email notifications (SendGrid) -----------------
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@lifelink.ai

# --- Optional: Rate limiting ----------------------------------
RATE_LIMIT_ENABLED=true

# --- Optional: Demo seed password ------------------------------
# DEMO_PASSWORD=ChangeThisInProduction

# ============================================================
# AI INFRASTRUCTURE - optional add-ons
# ============================================================

# --- Headroom (Context Compression) ---------------------------
# HEADROOM_ENABLED=false

# --- SIE (Superlinked Inference Engine) - embeddings/rerank ---
# SIE_ENABLED=false
# SIE_BASE_URL=http://localhost:8080
# SIE_API_KEY=

# --- Edge AI (Ambulance Runtime) -------------------------------
# EDGE_AI_ENABLED=false

# --- Feature Flags ---------------------------------------------
# ENABLE_SEMANTIC_SEARCH=true
# ENABLE_RERANKING=true
# ENABLE_AI_STRUCTURED_OUTPUT=true
# ENABLE_OFFLINE_AMBULANCE_MODE=false
# ENABLE_AI_OBSERVABILITY=true
# ENABLE_SCRAPLING_SEARCH=true
