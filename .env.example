# ============================================================
# LifeLink — Environment Variables
# Copy this to .env and fill in your API keys
# ============================================================

# ─── Required: LLM Provider (OpenAI-compatible endpoint) ──
# Primary: OpenAI-compatible API (from EVA/design.md config)
OPENAI_API_KEY=10a92e750d5616640645cd96755a7b2154d42d20602c15d2d9d513724750d3a0
OPENAI_BASE_URL=http://144.79.62.242:8000/v1
LLM_ENDPOINT=http://144.79.62.242:8000/v1/chat/completions
LLM_MODEL_NAME=qwen3.6-27b
LLM_MAX_OUTPUT_TOKENS=8192
LLM_PROVIDER=openai

# Fallback: Groq (if OpenAI endpoint is unreachable)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Security ──────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_string
JWT_SECRET=change_this_to_a_secure_random_string

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifelink_db

# ─── Redis & Celery ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Optional: Email Notifications ──────────────────────
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=noreply@lifelink.ai
